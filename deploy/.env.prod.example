# Copy to /opt/adwear/.env on the VPS and fill in real values.
# THIS FILE (the .env, not the .example) MUST NEVER BE COMMITTED.

# --- Image to run (CI updates :latest; pin a sha to roll back) ---
APP_IMAGE=ghcr.io/adwear-sk/prestashop:latest

# --- Public domain ---
PS_DOMAIN=www.adwear.sk
# Trust the request's REMOTE_ADDR as the proxy: Apache's mod_remoteip has already
# replaced Caddy's address with the visitor's, so a subnet here never matches and
# the back office loops on HTTPS (see docker-compose.yml).
PS_TRUSTED_PROXIES=REMOTE_ADDR

# --- Database (use long random passwords) ---
DB_ROOT_PASSWD=CHANGE_ME_root
DB_NAME=prestashop
DB_USER=prestashop
DB_PASSWD=CHANGE_ME_user
DB_PREFIX=ps_

# Malfini credentials are configured in the module's admin page (stored in the
# PrestaShop configuration table / DB), so they are NOT set here.

# Alerts and off-site backup (see README §10). ALERT_URL gets a plain POST
# (an ntfy topic works as is); healthcheck.sh and backup.sh use it.
ALERT_URL=
HC_BACKUP_URL=
BORG_REPO=
BORG_PASSPHRASE=
