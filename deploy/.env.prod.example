# Copy to /opt/adwear/.env on the VPS and fill in real values.
# THIS FILE (the .env, not the .example) MUST NEVER BE COMMITTED.

# --- Image to run (CI updates :latest; pin a sha to roll back) ---
APP_IMAGE=ghcr.io/adwear-sk/prestashop:latest

# --- Public domain ---
PS_DOMAIN=www.adwear.sk
# Docker bridge range so PrestaShop trusts Caddy's X-Forwarded-* headers.
PS_TRUSTED_PROXIES=172.16.0.0/12

# --- Database (use long random passwords) ---
DB_ROOT_PASSWD=CHANGE_ME_root
DB_NAME=prestashop
DB_USER=prestashop
DB_PASSWD=CHANGE_ME_user
DB_PREFIX=ps_

# Malfini credentials are configured in the module's admin page (stored in the
# PrestaShop configuration table / DB), so they are NOT set here.
