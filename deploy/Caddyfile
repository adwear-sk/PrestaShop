# Auto-HTTPS for www.adwear.sk. Caddy obtains + renews Let's Encrypt certs
# automatically — no certbot, no cron, nothing to remember.

www.adwear.sk {
	encode zstd gzip
	# The back office is hardened by renaming its folder to an unguessable
	# name (injected at build time from the ADMIN_FOLDER CI secret), so there
	# is no fixed /admin-dev path for bots to find. Nothing to gate here.
	reverse_proxy app:80 {
		header_up X-Forwarded-Proto https
	}
}

# Redirect the apex to www (canonical host).
adwear.sk {
	redir https://www.adwear.sk{uri} permanent
}
