# Auto-HTTPS for www.adwear.sk. Caddy obtains + renews Let's Encrypt certs
# automatically — no certbot, no cron, nothing to remember.
#
# Runs the image from caddy/Dockerfile (stock Caddy + the rate_limit handler).
{
	order rate_limit before basic_auth
}

# Browser security headers for every response, including static files and
# Caddy's own 403/404/429. The CSP is structural only: core and module hooks
# print inline scripts, so a script-src allowlist would need 'unsafe-inline'
# and add little. frame-ancestors is 'self', not 'none': the ps_adwearslider
# back-office preview frames the shop. No form-action and no payment=() so a
# future card gateway isn't blocked. HSTS starts short; raise it to 31536000
# after a clean week (board item sec-headers). No includeSubDomains/preload:
# *.adwear.sk resolves to this server without TLS.
(security_headers) {
	header {
		Strict-Transport-Security "max-age=300"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), usb=()"
		Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
		-Server
		-Via
	}
}

www.adwear.sk {
	import security_headers
	# Error responses (the rate limits' 429) skip the normal route, so their
	# headers are set here.
	handle_errors {
		import security_headers
	}
	encode zstd gzip
	# The back office is hardened by renaming its folder to an unguessable
	# name (injected at build time from the ADMIN_FOLDER CI secret), so there
	# is no fixed /admin-dev path for bots to find. Nothing to gate here.

	# The only place the real client IP is recorded (Apache gets it through
	# X-Forwarded-For). Mounted at /opt/adwear/logs/caddy on the VPS; kept 14
	# days for abuse analysis. Cookie and Authorization headers are redacted
	# by Caddy itself.
	log {
		output file /var/log/caddy/access.log {
			mode 0644
			roll_size 50MiB
			roll_keep 20
			roll_keep_for 336h
		}
		format json
	}

	# Installer, git metadata and repo files that must never be served. The
	# image no longer ships most of them; this covers older images and any
	# file that slips back in. 404, so probes learn nothing.
	@repoFiles {
		path /install-dev /install-dev/* /install /install/* /.* /.*/* *.md /composer.json /composer.lock /Makefile /docker-compose*.yml /phpunit*.xml
		not path /.well-known/*
	}
	respond @repoFiles 404

	# Faceted filters on the Home category count across the whole catalogue.
	# On 2026-11-10 a scraper with rotating browser user agents walked random
	# filter combinations there (~550/h) and filled every MySQL connection.
	# Shoppers filter inside real categories, so refuse it before PHP.
	@homeFilters {
		path_regexp ^/2-
		query q=*
	}
	respond @homeFilters "Filtering is not available on this page." 403

	# Each filter request runs a set of catalogue-wide COUNT queries, so cap
	# them per client IP (429 + Retry-After past the limit). A shopper clicking
	# through filters stays well under both; a scraper walking combinations
	# does not.
	rate_limit {
		zone filters_minute {
			match {
				query q=*
			}
			key {remote_host}
			events 20
			window 1m
		}
		zone filters_hour {
			match {
				query q=*
			}
			key {remote_host}
			events 150
			window 1h
		}
		# Account, contact and comment forms: cap POSTs per client IP against
		# password guessing and mail/spam floods. Slugs are the Slovak
		# ps_meta_lang rewrites; the second match covers the same controllers
		# without URL rewriting. Cart, checkout and search AJAX are not matched.
		# Not covered: the newsletter form (posts to the current page) and the
		# login step inside /objednavka.
		zone forms_minute {
			match {
				method POST
				path /prihlasit-sa* /registrácia* /registr%C3%A1cia* /obnova-hesla* /kontaktujte-nas* /sledovanie-objednavok-pre-navstevnikov* /module/productcomments/PostComment* /module/productcomments/ReportComment* /module/ps_emailalerts/*
			}
			match {
				method POST
				query controller=authentication controller=registration controller=password controller=contact controller=guest-tracking
			}
			match {
				method POST
				query module=productcomments module=ps_emailalerts
			}
			key {remote_host}
			events 20
			window 1m
		}
	}

	reverse_proxy app:80 {
		header_up X-Forwarded-Proto https
		# PrestaShop trusts X-Forwarded-Port too (PS_TRUSTED_PROXIES=REMOTE_ADDR)
		# and Caddy doesn't set it, so pin it instead of passing the client's on.
		header_up X-Forwarded-Port 443
	}
}

# Redirect the apex to www (canonical host). The http:// block makes plain
# http://adwear.sk go straight to https://www in one hop instead of first
# upgrading to https://adwear.sk.
adwear.sk {
	import security_headers
	redir https://www.adwear.sk{uri} permanent
}

http://adwear.sk {
	redir https://www.adwear.sk{uri} permanent
}
